# Copy to .env for local development. NEVER commit .env. Placeholders only.

APP_ENV=development                 # development | production
# DATABASE_URL=postgresql://user:password@host:5432/careerpilot   # unset -> local SQLite in ./data

# ---- AI provider: none | ollama | openai_compatible | anthropic ----
LLM_PROVIDER=none
LLM_MODEL=
# Local Ollama:      LLM_PROVIDER=ollama  LLM_MODEL=llama3.2  OLLAMA_HOST=http://localhost:11434
# Hosted (any OpenAI-compatible API, e.g. Groq/OpenRouter/Together):
#                    LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://<provider>/v1  LLM_API_KEY=your-key-here  LLM_MODEL=<model id>
# Anthropic API:     LLM_PROVIDER=anthropic  LLM_API_KEY=your-key-here  LLM_MODEL=<model id>
LLM_BASE_URL=
LLM_API_KEY=
OLLAMA_HOST=http://localhost:11434

# ---- Embeddings: auto | sentence_transformers | hashing ----
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Vector store: auto (ChromaDB if installed) | chroma | memory. See README "Known limitations" re ChromaDB advisories.
VECTOR_BACKEND=auto

# ---- Privacy / limits ----
MAX_UPLOAD_MB=5
RESUME_RETENTION_DAYS=90
OCR_ENABLED=false
AI_CALLS_PER_HOUR=40
SESSION_TTL_HOURS=24

# ---- Ingestion (be polite; identify yourself) ----
HTTP_USER_AGENT=CareerPilotAI/1.0 (contact: you@example.com)
HTTP_MIN_INTERVAL_SECONDS=1.0
STALE_AFTER_HOURS=72

# ---- Adzuna India job-search API (optional, free key from developer.adzuna.com) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
